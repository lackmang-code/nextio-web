#!/bin/sh
# Next I/O 홈페이지 저장소는 Public GitHub repo다.
# 내부 전용 문서(가격·계약·리드·기밀 등)가 실수로 커밋되는 걸 막는 안전장치.
# 우회하려면: git commit --no-verify (정말 의도한 경우에만 사용)

# ⚠ git 은 비ASCII 경로를 "\354\227\260..." 로 이스케이프해 넘긴다.
#   그러면 아래 한글 파일명 패턴이 하나도 발화하지 않는다 (2026-09-03 디플 발견).
#   저장소 로컬 core.quotepath=false 에 기대면 클론했을 때 죽으므로 여기서 직접 끈다.
staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM)
IFS='
'
[ -z "$staged" ] && exit 0

# 1) 파일 경로/이름에 민감 키워드가 있으면 차단
# 2026-08-25: 일일보고 6건(5~8월)이 이 목록에 없어 그대로 공개돼 있었다.
# 세션 보고서·계획서·지시서 계열을 통째로 막는다.
path_pattern='handbook|NDA|nda|견적|계약서|리드DB|리드db|컨택리스트|독소조항|내부문서|기밀|confidential|salary|연봉|급여|보고_|일일보고|브리핑_|작업지시서|modify_plan|착수점|_전략|세션정리|CLAUDE.md|rules.md|.agents/|연동규격|검수_|회신_|시말서'
bad_paths=$(echo "$staged" | grep -E -i "$path_pattern")

# 2) 파일 내용에 비밀키/시크릿 패턴이 있으면 차단
bad_content=""
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.svg|*.ico|*.pdf|*.woff|*.woff2|*.ttf) continue ;;
  esac
  if grep -I -q -E "BEGIN (RSA|OPENSSH|PRIVATE) KEY|api[_-]?key\s*[:=]\s*['\"][A-Za-z0-9_\-]{16,}|AKIA[0-9A-Z]{16}|password\s*[:=]\s*['\"][^'\"]{4,}" "$f" 2>/dev/null; then
    bad_content="$bad_content$f\n"
  fi
done

# 3) 대용량 파일 차단 (2026-08-24 대표 지시로 강화)
#    git 은 파일을 지워도 히스토리에 남아 저장소가 영구히 무거워진다.
#    실제로 education png 69MB·매거진 인쇄용 PDF 47.8MB 가 들어가 저장소가
#    199MB 까지 불었고, 2026-08-24 에 히스토리를 재작성해야 했다(→16MB).
#    "일단 올리고 나중에 정리"는 원리적으로 통하지 않는다.
WARN_KB=500      # 경고
BLOCK_KB=2000    # 차단
big_files=""
warn_files=""
for f in $staged; do
  [ -f "$f" ] || continue
  kb=$(du -k "$f" 2>/dev/null | cut -f1)
  [ -z "$kb" ] && continue
  if [ "$kb" -gt "$BLOCK_KB" ]; then
    big_files="$big_files   ${kb}KB  $f
"
  elif [ "$kb" -gt "$WARN_KB" ]; then
    warn_files="$warn_files   ${kb}KB  $f
"
  fi
done

if [ -n "$warn_files" ]; then
  echo ""
  echo "⚠️  용량이 큰 파일이 있습니다 (${WARN_KB}KB 초과). 차단은 아니지만 줄일 수 있는지 보세요."
  printf "%b" "$warn_files"
  echo "   이미지는 webp, 영상은 재인코딩. 히스토리에 남으면 되돌릴 수 없습니다."
  echo ""
fi

if [ -n "$big_files" ]; then
  echo ""
  echo "🚫 커밋 차단: ${BLOCK_KB}KB 를 넘는 파일이 있습니다."
  echo ""
  printf "%b" "$big_files"
  echo ""
  echo "   git 은 지워도 히스토리에 남습니다. 한번 올리면 저장소가 영구히 무거워집니다."
  echo "   (2026-08-24: 이런 파일들 때문에 저장소가 199MB 까지 불어 히스토리를 재작성했습니다)"
  echo ""
  echo "   해결: 이미지는 webp 변환 · 영상은 재인코딩 · 인쇄용 원본/제출본은"
  echo "         저장소가 아니라 01_Company\회사공용자료\ 같은 비공개 위치에 보관"
  echo ""
  echo "   꼭 필요한 파일이면(예: 히어로 영상 교체): git commit --no-verify"
  echo ""
  exit 1
fi

if [ -n "$bad_paths" ] || [ -n "$bad_content" ]; then
  echo ""
  echo "🚫 커밋 차단: 이 저장소(nextio-web)는 Public입니다."
  echo ""
  [ -n "$bad_paths" ] && printf "   민감 파일명으로 의심되는 파일:\n%s\n\n" "$bad_paths"
  [ -n "$bad_content" ] && printf "   민감 내용(키/비밀번호 패턴)이 의심되는 파일:\n%b\n" "$bad_content"
  echo "   내부 전용 문서(가격·계약·리드·NDA 등)는 이 저장소에 커밋하지 말고"
  echo "   회사공용자료(비공개 위치)에 보관하세요."
  echo ""
  echo "   정말 의도한 파일이면: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
